[Unit]
Description=Useproof product site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/useproof
ExecStart=/usr/bin/python3 -m http.server 3333 --bind 0.0.0.0 --directory /root/useproof/site
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
